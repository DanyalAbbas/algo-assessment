# PostgreSQL connection (local docker-compose defaults)
DATABASE_URL=postgresql://app:app@localhost:5432/algo_assessment
# Optional: explicit Prisma connection pool size (recommended in production,
# where the CPU-derived default is tiny). Ignored if already in DATABASE_URL.
DATABASE_POOL_SIZE=10

# JWT secret for auth.
# REQUIRED and must be a random string of >=32 chars. The app refuses to start
# with a missing/weak/placeholder value. Generate one with: openssl rand -base64 48
JWT_SECRET=
# Short-lived access token (minutes). The refresh token is the long-lived credential.
JWT_EXPIRES_IN=15m
# Rotating refresh token lifetime (revocable server-side)
REFRESH_TOKEN_EXPIRES_IN=7d

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# Max time the categorization worker waits on one LLM call before giving up
LLM_TIMEOUT_MS=5000
# How many background categorization calls may run at once
LLM_CONCURRENCY=3

# Server
PORT=3000

# Rate limiting
# Global default: requests per window per IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=2000
# Stricter limits on credential endpoints
AUTH_LOGIN_RATE_LIMIT=60
AUTH_REFRESH_RATE_LIMIT=120
